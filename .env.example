# Copier en .env puis renseigner. Ne jamais versionner .env.

# --- Météo (OpenWeather One Call API 3.0) ---
OPENWEATHER_API_KEY=
WEATHER_LAT=48.8566
WEATHER_LON=2.3522
LOCATION_NAME=Paris

# --- Google Calendar (optionnel) ---
GCAL_ENABLED=false
GCAL_CALENDAR_ID=primary
GCAL_DAYS_AHEAD=1
# GCAL_TOKEN_PATH=~/weather-display/token.json
